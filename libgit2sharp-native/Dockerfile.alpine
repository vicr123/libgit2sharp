FROM mcr.microsoft.com/dotnet/sdk:9.0-alpine

# Install build dependencies (PowerShell is already included in the base image)
RUN apk add --no-cache \
    build-base \
    cmake \
    ninja \
    git \
    pkgconfig \
    openssl-dev \
    linux-headers

WORKDIR /src

COPY . .

ENTRYPOINT ["pwsh", "/src/libgit2sharp-native/build-native.ps1"]
