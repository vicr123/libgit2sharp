FROM mcr.microsoft.com/dotnet/sdk:8.0-noble

# Install build dependencies (PowerShell is already included in the base image)
RUN apt-get update && \
    apt-get install -y \
        build-essential \
        cmake \
        ninja-build \
        git \
        pkg-config \
        libssl-dev \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY . .

ENTRYPOINT ["pwsh", "/src/libgit2sharp-native/build-native.ps1"]
